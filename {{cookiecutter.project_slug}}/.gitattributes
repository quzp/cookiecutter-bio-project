* text=auto eol=lf

*.R      text diff=r
*.qmd    text
*.md     text
*.tsv    text
*.csv    text

*.png    binary
*.pdf    binary
*.tif    binary
*.xlsx   binary
*.docx   binary
*.pptx   binary

