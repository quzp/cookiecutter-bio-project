# ---- Data: excluded by default, except the sample sheet and README files ----
data/**
!data/**/
!data/**/README.md
!data/metadata/**
data/metadata/**/*.rds
data/metadata/**/*.h5ad

# ---- Script output: regenerable, not versioned ----
results/figures/**
!results/figures/README.md
results/tables/**
!results/tables/README.md

# ---- Environment ----
.pixi/
# pixi.lock MUST be committed; it is what makes the environment reproducible

# ---- R ----
.Rhistory
.RData
.Rproj.user/
*.Rproj

# ---- Python ----
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/

# ---- Quarto / LaTeX ----
/.quarto/
*_files/
*.aux
*.log
*.out
*.bbl
*.blg
*.synctex.gz

# ---- OS ----
.DS_Store
Thumbs.db
*~
